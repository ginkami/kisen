// event (коллекция events)
{
    "id": "UUIDv7", // (PK)
    "slug": "String", 
    // ^ (Required, Unique) Автоматически генерируется короткий уникальный случайный набор символов (только строчные латинские буквы и цифры), 
    // но у пользователя есть возможность отредактировать - ввести свой вариант (строчные латинские буквы, цифры и дефисы).
    // Используется для прямой ссылки на мероприятие
    "createdBy": "UID", // (Required, Ref: user.id) Пользователь, кто создал мероприятие
    "hostAssociation": "UUIDv7", // (Required, Ref: association.id) Ассоциация под эгидой которой проводится мероприятие. 
    "updatedAt": "Date",  // (Required) Время последнего обновления по мероприятию 
    "startYearMonth": "yyyyMM", // (Required) Год и месяц мероприятия для быстрого поиска по месяцам.
    "locales": { // (Required)
        "ru": { // [ >= 1] Должна быть хотя бы одна локаль. При рендеринге берутся значения для текущей локали, либо другой существующей
            "title": "String", // (Required)
            "description": "String" // Поддерживается Markdown синтаксис
        }
    }
}