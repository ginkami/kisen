// player (коллекция players)
{
    "id": "UUIDv7", // (PK)
    "createdBy": "UID", // (Required, Ref: user.id) Пользователь, кто внёс игрока в базу
    "locales": { // (Required) Набор локалей
        "ru": { // [ >= 1] Должна быть хотя бы одна локаль. При рендеринге берутся значения для текущей локали, если нет, то для другой существующей
            "familyName": "String", // (Required)
            "givenName": "String", // (Required)
            "title": "String", // Звание или титул игрока
            "club": "String",
            "location": "String" // Место (город/посёлок) проживания
        }
    },
    "nationality": "ISO 3166-1 alpha-2", // (Required) Страна гражданства
    "residence": "ISO 3166-1 alpha-2", // Страна проживания
    "gender": "'men' | 'women' | null", // (Required) null - если не указан 
    "currentRating": { // (Required, Ref: playerRating.ts)
        "value": "Decimal | null", // Числовое значение рейтинга. null, если отсутствует.
        "rank": "String | null" // Ref: Ранг Кю/Дан. Значения: '20k'...'1k' (Кю), '1d'...'9d' (Дан). null, если разряда нет.
    },
    // ^ (Optional) Актуальный рейтинг.
    "birthDate": "Date | null", // (Required)
    "primaryAssociation": "UUIDv7 | null", // Ассоциация, с которой игрока аффилировал createdBy пользователь 
    // ^ (Required, Ref: association.id)
    "secondaryAssociations": [ // Массив ассоциаций, с которыми аффилирован игрок, по предложению других пользователей с ролью 'manager' и выше
        "UUIDv7" // (Ref: association.id)
    ]
    // ^ (Required) Может быть пустым.
}