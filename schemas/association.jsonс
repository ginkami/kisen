// association (коллекция associations)
{
    "id": "UUIDv7", // (PK)
    "slug": "String", 
    // ^ (Required, Unique) Пользователю предлагается ввести свой вариант (строчные латинские буквы, цифры и дефисы).
    "createdBy": "UID", // (Required, Ref: user.id) Пользователь, кто основал ассоциацию
    "locales": { // (Required)
        "ru": { // [ >= 1] Должна быть хотя бы одна локаль. При рендеринге берутся значения для текущей локали, либо для другой существующей
            "title": "String", // (Required)
            "description": "String", // Поддерживается Markdown синтаксис
            "location": "String"
        }
    },
    "country": "ISO 3166-1 alpha-2",
    "managers": [ "UID" ], // (Ref: user.id)
    // ^ Массив пользователей-администраторов ассоциации (смогут управлять от лица ассоциации, только если у них роль `manager`)
    "pendingInvites": [ "String" ] // Email-адреса приглашенных, кто еще не зарегистрировался. Если зарегистрирован, то переносится в "managers" UID (user.id)  
}