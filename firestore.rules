rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserId() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(createdBy) {
      return isAuthenticated() && createdBy == currentUserId();
    }

    function isManagerOf(associationId) {
      return isAuthenticated()
        && associationId != null
        && currentUserId() in get(/databases/$(database)/documents/associations/$(associationId)).data.managers;
    }

    function hasManagerAccess(resource) {
      let associationId = resource.data.hostAssociation;
      return isManagerOf(associationId);
    }

    function hasPlayerManagerAccess(resource) {
      let associationId = resource.data.primaryAssociation;
      return isManagerOf(associationId);
    }

    // ---------- Users (Профили пользователей) ----------
    match /users/{userId} {
      // Читать свой профиль может сам пользователь или администратор
      allow read: if isAuthenticated() && (currentUserId() == userId || isAdmin());
      
      // Создать профиль может только сам пользователь в момент регистрации
      allow create: if isAuthenticated() && currentUserId() == userId;
      
      // Обновлять профиль может сам пользователь (например, менять имя) или администратор
      // (Внимание: если вы храните роль внутри документа, убедитесь на фронтенде, 
      // что обычный пользователь не может перезаписать свое поле role на 'admin')
      allow update: if isAuthenticated() && (currentUserId() == userId || isAdmin());
      
      // Удалять профили может только администратор
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      // Читать свой профиль может сам пользователь или администратор
      allow read: if isAuthenticated() && (currentUserId() == userId || isAdmin());

      // Создать профиль может только сам пользователь в момент регистрации
      allow create: if isAuthenticated() && currentUserId() == userId;
      
      // Обновлять профиль может сам пользователь (например, менять имя) или администратор
      allow update: if isAuthenticated() && (currentUserId() == userId || isAdmin())
        && (
          // Если обновляет админ — ему можно всё
          isAdmin() 
          // Если обновляет сам пользователь — мы проверяем, что поле 'role' НЕ изменилось
          || (
            // Вариант 1: Новое значение роли в запросе совпадает со старым значением в базе
            // request.resource.data.role == resource.data.role
            // Вариант 2 (более строгий): Проверяем, что ключ 'role' вообще не затрагивался в операции diff
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          )
        );

      // Удалять профили может только администратор
      allow delete: if isAdmin();
    }

    // ---------- Associations (Ассоциации) ----------
    match /associations/{associationId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isManagerOf(associationId);
      allow delete: if isAdmin();
    }

    // ---------- Players (Игроки) ----------
    match /players/{playerId} {
      allow read: if true;

      // Создание: админ ИЛИ менеджер ассоциации, указанной в качестве primaryAssociation.
      allow create: if isAdmin()
        || (
          isAuthenticated()
          && request.resource.data.primaryAssociation != null
          && isManagerOf(request.resource.data.primaryAssociation)
        );

      // Обновление: создатель записи, админ ИЛИ менеджер ассоциации игрока.
      allow update: if isAdmin()
        || isOwner(resource.data.createdBy)
        || hasPlayerManagerAccess(resource);

      // Удаление: админ ИЛИ менеджер ассоциации игрока.
      allow delete: if isAdmin() || hasPlayerManagerAccess(resource);
    }

    // ---------- Tournaments (Турниры) ----------
    match /tournaments/{tournamentId} {
      function canReadTournament() {
        return resource.data.status != 'draft'
          || isOwner(resource.data.createdBy)
          || isAdmin()
          || isManagerOf(resource.data.hostAssociation);
      }

      allow read: if canReadTournament();

      allow create: if isAuthenticated()
        && (
          request.resource.data.hostAssociation == null
          || isManagerOf(request.resource.data.hostAssociation)
        );

      allow update: if isAdmin()
        || isOwner(resource.data.createdBy)
        || isManagerOf(resource.data.hostAssociation);

      allow delete: if isAdmin()
        || isOwner(resource.data.createdBy)
        || isManagerOf(resource.data.hostAssociation);
    }

    // ---------- Events (Мероприятия) ----------
    match /events/{eventId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && (
          request.resource.data.hostAssociation == null
          || isManagerOf(request.resource.data.hostAssociation)
        );

      allow update: if isAdmin()
        || isOwner(resource.data.createdBy)
        || isManagerOf(resource.data.hostAssociation);

      allow delete: if isAdmin()
        || isOwner(resource.data.createdBy)
        || isManagerOf(resource.data.hostAssociation);
    }
  }
}