rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserId() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(createdBy) {
      return isAuthenticated() && createdBy == currentUserId();
    }

    function isCreatorOf(associationId) {
      return isAuthenticated()
        && associationId != null
        && get(/databases/$(database)/documents/associations/$(associationId)).data.createdBy == currentUserId();
    }

    // True when the authenticated user profile exists and is not blocked
    // (auth.isActive is missing on legacy profiles, which counts as active).
    function isUserActive() {
      return get(/databases/$(database)/documents/users/$(currentUserId())).data.auth.isActive != false;
    }

    function isManagerOf(associationId) {
      return isAuthenticated()
        && associationId != null
        && currentUserId() in get(/databases/$(database)/documents/associations/$(associationId)).data.managers;
    }

    function canActForAssociation(associationId) {
      return isManagerOf(associationId) || isCreatorOf(associationId);
    }

    function hasManagerAccess(resource) {
      return isManagerOf(resource.data.hostAssociation);
    }

    function hasPlayerManagerAccess(resource) {
      return isManagerOf(resource.data.primaryAssociation);
    }

    // True when the user can act for at least one association listed in the
    // player's secondaryAssociations (i.e. the list is non-empty and the user
    // is manager/creator of at least one of its entries).
    function hasSecondaryAssociationAccess(resource) {
      return isAuthenticated()
        && !(resource.data.get('secondaryAssociations', []).all(
          associationId, !canActForAssociation(associationId)
        ));
    }

    // ---------- Users (РџСЂРѕС„РёР»Рё РїРѕР»СЊР·РѕРІР°С‚РµР»РµР№) ----------
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && currentUserId() == userId;
      allow update: if isAuthenticated() && (currentUserId() == userId || isAdmin())
        && isUserActive()
        && (
          isAdmin()
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'auth.isActive'])
        );
      allow delete: if isAdmin();
    }

    // ---------- App settings (singleton application settings document) ----------
    match /app/settings {
      // Public read: the header hides the guest auth buttons for visitors.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // ---------- Promotions (продвижение турниров) ----------
    match /promotions/{promotionId} {
      // Public read: the home page renders promoted tournament cards for visitors.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    // ---------- Associations (РђСЃСЃРѕС†РёР°С†РёРё) ----------
    match /associations/{associationId} {
      allow read: if true;
      allow create: if (isAdmin() || isAuthenticated()) && isUserActive();
      allow update: if (isAdmin() || isCreatorOf(associationId) || isManagerOf(associationId)) && isUserActive();
      allow delete: if (isAdmin() || isCreatorOf(associationId)) && isUserActive();
    }

    // ---------- Players (РРіСЂРѕРєРё) ----------
    match /players/{playerId} {
      allow read: if true;

      // Admin (custom claim) can always create.
      // Authenticated owner can create with or without primaryAssociation.
      // Manager of a primary association can create.
      allow create: if isAdmin()
        || isOwner(request.resource.data.createdBy)
        || (
          isAuthenticated()
          && request.resource.data.get('primaryAssociation', null) != null
          && isManagerOf(request.resource.data.primaryAssociation)
        )
        && isUserActive();

      // Clearing primaryAssociation (null) or removing an id from
      // secondaryAssociations is allowed for admin/owner/primary-manager and
      // for anyone who can act for the old primary or one of the old secondary
      // associations (e.g. while that association is being deleted).
      allow update: if (isAdmin()
          || isOwner(resource.data.createdBy)
          || hasPlayerManagerAccess(resource)
          || canActForAssociation(resource.data.get('primaryAssociation', null))
          || hasSecondaryAssociationAccess(resource)
        )
        && isUserActive();

      allow delete: if (isAdmin() || hasPlayerManagerAccess(resource)) && isUserActive();
    }

    // ---------- Tournaments (РўСѓСЂРЅРёСЂС‹) ----------
    match /tournaments/{tournamentId} {

      // РЎРёРЅС…СЂРѕРЅРёР·Р°С†РёСЏ isPublic Рё status
      function isValidPublicStatus() {
        return request.resource.data.isPublic == (
          request.resource.data.status != 'draft'
          && request.resource.data.status != 'proposed_for_removing'
        );
      }

      // Р•СЃР»Рё С…РѕСЃС‚-Р°СЃСЃРѕС†РёР°С†РёСЏ РјРµРЅСЏРµС‚СЃСЏ, РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РґРѕР»Р¶РµРЅ Р±С‹С‚СЊ РјРµРЅРµРґР¶РµСЂРѕРј РёР»Рё СЃРѕР·РґР°С‚РµР»РµРј РЅРѕРІРѕР№.
      // РћС‡РёСЃС‚РєР° СЃСЃС‹Р»РєРё (null) СЂР°Р·СЂРµС€РµРЅР° С‚РѕРјСѓ, РєС‚Рѕ РјРѕР¶РµС‚ РґРµР№СЃС‚РІРѕРІР°С‚СЊ РѕС‚ РёРјРµРЅРё СЃС‚Р°СЂРѕР№ Р°СЃСЃРѕС†РёР°С†РёРё
      // (РЅР°РїСЂРёРјРµСЂ, РїСЂРё РµС‘ СѓРґР°Р»РµРЅРёРё).
      function isValidHostAssociationChange() {
        return request.resource.data.get('hostAssociation', null) == resource.data.get('hostAssociation', null)
          || canActForAssociation(request.resource.data.get('hostAssociation', null))
          || canActForAssociation(resource.data.get('hostAssociation', null));
      }

      allow read: if true;

      allow create: if isAuthenticated()
        && (
          request.resource.data.get('hostAssociation', null) == null
          || canActForAssociation(request.resource.data.hostAssociation)
        )
        && isValidPublicStatus()
        && isUserActive();

      // Optimistic concurrency: a save must be prepared against the stored
      // revision and write exactly the next one (legacy documents start at 0).
      function isValidRevisionStep() {
        return request.resource.data.get('revision', 0) == resource.data.get('revision', 0) + 1;
      }

      allow update: if (
          isAdmin()
          || isOwner(resource.data.createdBy)
          || canActForAssociation(resource.data.hostAssociation)
        )
        && isValidPublicStatus()
        && isValidHostAssociationChange()
        && isValidRevisionStep()
        && isUserActive();

      // Editing presence sessions (one document per editor, keyed by user id).
      match /sessions/{sessionId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null
          && request.auth.uid == sessionId;
      }

      allow delete: if (isAdmin()
        || isOwner(resource.data.createdBy)
        || canActForAssociation(resource.data.hostAssociation)
        )
        && isUserActive();
    }

    // ---------- Events (РњРµСЂРѕРїСЂРёСЏС‚РёСЏ) ----------
    match /events/{eventId} {
      allow read: if true;

      // РћС‡РёСЃС‚РєР° СЃСЃС‹Р»РєРё (null) СЂР°Р·СЂРµС€РµРЅР° С‚РѕРјСѓ, РєС‚Рѕ РјРѕР¶РµС‚ РґРµР№СЃС‚РІРѕРІР°С‚СЊ РѕС‚ РёРјРµРЅРё СЃС‚Р°СЂРѕР№ Р°СЃСЃРѕС†РёР°С†РёРё.
      function isValidEventHostAssociationChange() {
        return request.resource.data.get('hostAssociation', null) == resource.data.get('hostAssociation', null)
          || canActForAssociation(request.resource.data.get('hostAssociation', null))
          || canActForAssociation(resource.data.get('hostAssociation', null));
      }

      allow create: if isAuthenticated()
        && (
          request.resource.data.get('hostAssociation', null) == null
          || canActForAssociation(request.resource.data.hostAssociation)
        )
        && isUserActive();

      allow update: if (
          isAdmin()
          || isOwner(resource.data.createdBy)
          || canActForAssociation(resource.data.hostAssociation)
        )
        && isValidEventHostAssociationChange()
        && isUserActive();

      allow delete: if (isAdmin()
        || isOwner(resource.data.createdBy)
        || canActForAssociation(resource.data.hostAssociation)
        )
        && isUserActive();
    }

    // ---------- Regulations (Р РµРіР»Р°РјРµРЅС‚С‹) ----------
    match /regulations/{regulationId} {
      allow read: if true;

      // РћС‡РёСЃС‚РєР° СЃСЃС‹Р»РєРё (null) СЂР°Р·СЂРµС€РµРЅР° С‚РѕРјСѓ, РєС‚Рѕ РјРѕР¶РµС‚ РґРµР№СЃС‚РІРѕРІР°С‚СЊ РѕС‚ РёРјРµРЅРё СЃС‚Р°СЂРѕР№ Р°СЃСЃРѕС†РёР°С†РёРё.
      function isValidAssociationChange() {
        return request.resource.data.get('association', null) == resource.data.get('association', null)
          || canActForAssociation(request.resource.data.get('association', null))
          || canActForAssociation(resource.data.get('association', null));
      }

      allow create: if isAuthenticated()
        && (
          request.resource.data.get('association', null) == null
          || canActForAssociation(request.resource.data.association)
        )
        && isUserActive();

      allow update: if (
          isAdmin()
          || isOwner(resource.data.createdBy)
          || canActForAssociation(resource.data.association)
        )
        && isValidAssociationChange()
        && isUserActive();

      allow delete: if (isAdmin()
        || isOwner(resource.data.createdBy)
        )
        && isUserActive();
    }
  }
}
